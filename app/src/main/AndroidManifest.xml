<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuitSmoke">

        <!-- 主Activity - 统计分析页面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuitSmoke">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 历史记录Activity -->
        <activity
            android:name=".HistoryActivity"
            android:label="抽烟记录"
            android:parentActivityName=".MainActivity" />

        <!-- 设置Activity -->
        <activity
            android:name=".SettingsActivity"
            android:label="设置"
            android:parentActivityName=".MainActivity" />

        <!-- 某天详情Activity -->
        <activity
            android:name=".DayDetailActivity"
            android:label="当日记录"
            android:parentActivityName=".HistoryActivity" />

        <!-- 手动添加记录Activity -->
        <activity
            android:name=".AddRecordActivity"
            android:label="手动添加"
            android:parentActivityName=".MainActivity" />

        <!-- 桌面小组件 - 4x1 尺寸 -->
        <receiver
            android:name=".widget.SmokeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smoke_widget_info" />
        </receiver>

        <!-- 小组件点击广播接收器 -->
        <receiver
            android:name=".widget.SmokeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.quitsmoke.app.ACTION_SMOKE" />
                <action android:name="com.quitsmoke.app.ACTION_UNDO" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

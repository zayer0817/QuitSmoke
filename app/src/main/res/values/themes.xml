<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题 -->
    <style name="Theme.QuitSmoke" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6B6B</item>
        <item name="colorPrimaryVariant">#EE5A24</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4CAF50</item>
        <item name="colorSecondaryVariant">#66BB6A</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <!-- 沉浸式状态栏：透明背景 + 深色图标 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 深色主题 - 和默认DayNight自动匹配 -->
    <style name="Theme.QuitSmoke.Dark" parent="Theme.QuitSmoke" />
</resources>
